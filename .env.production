# 배포(npm run build)할 때 쓰는 Firebase 웹 설정값입니다.
# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱의 firebaseConfig 값을 넣으세요.
# 브라우저에 그대로 공개되는 값이라 커밋해도 됩니다. 실제 보안은 firestore.rules 가 담당합니다.
# 비워 두면 로그인 버튼이 숨겨지고 기록은 기기에만 저장됩니다.
VITE_FIREBASE_API_KEY=AIzaSyCpAGVQkmkG1UDRN2xMO4-Z0YeTnwObfo8
VITE_FIREBASE_AUTH_DOMAIN=leelmell-1a2ab.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=leelmell-1a2ab
VITE_FIREBASE_STORAGE_BUCKET=leelmell-1a2ab.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=980497145661
VITE_FIREBASE_APP_ID=1:980497145661:web:e36c665d2b35523fe86f54
# Google 애널리틱스 (방문 통계). 비워 두면 통계를 보내지 않습니다
VITE_FIREBASE_MEASUREMENT_ID=G-4H9NG0LD5N
# 안드로이드 앱의 Google 로그인용 "웹 클라이언트 ID" (Firebase → Authentication → Google → 웹 SDK 구성). 공개 값입니다
VITE_GOOGLE_WEB_CLIENT_ID=
