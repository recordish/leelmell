rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // 관리자: admins/{uid} 문서가 있는 계정 (Firebase 콘솔에서 직접 만듭니다. 앱에서는 만들 수 없음)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // 계정 데이터: 본인만 쓰고 지울 수 있고, 읽기는 본인과 관리자
    // (지금은 유료 상품이 없어 재화 계산을 앱에서 합니다. 결제를 붙일 때는 서버 함수로 옮겨야 합니다)
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['g', 'email', 'updatedAt', 'createdAt', 'platform'])
        && request.resource.data.updatedAt == request.time
        && (!('platform' in request.resource.data) || request.resource.data.platform in ['app', 'web'])
        && validCreatedAt()
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && validGame(request.resource.data.g);
    }

    // 가입 시간: 처음 만들 때만 지금 시간으로 쓰고, 그 뒤로는 바꿀 수 없습니다 (예전 계정은 비어 있음)
    function validCreatedAt() {
      return resource == null
        ? (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        : (('createdAt' in resource.data && request.resource.data.get('createdAt', null) == resource.data.createdAt)
          || (!('createdAt' in resource.data) && !('createdAt' in request.resource.data)));
    }

    // 하루 접속 수: 누구나 하루 한 번 app 또는 web 을 1씩만 올릴 수 있고, 읽기는 관리자만
    match /visits/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ((request.resource.data.keys().hasOnly(['app']) && request.resource.data.app == 1)
          || (request.resource.data.keys().hasOnly(['web']) && request.resource.data.web == 1));
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['app'])
          && request.resource.data.app == resource.data.get('app', 0) + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['web'])
          && request.resource.data.web == resource.data.get('web', 0) + 1);
    }

    // 방문 기록: 누구나 한 줄씩 만들 수 있고(정해진 항목만), 본 화면 수(views)만 늘릴 수 있습니다. 읽기는 관리자만
    match /hits/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['ch', 'src', 'landing', 'country', 'lang', 'device', 'os', 'browser', 'first', 'views', 'at'])
        && request.resource.data.ch in ['app', 'direct', 'search', 'sns', 'site']
        && request.resource.data.src is string && request.resource.data.src.size() <= 60
        && request.resource.data.landing is string && request.resource.data.landing.size() <= 20
        && request.resource.data.country is string && request.resource.data.country.size() <= 3
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 20
        && request.resource.data.device in ['phone', 'tablet', 'pc']
        && request.resource.data.os is string && request.resource.data.os.size() <= 12
        && request.resource.data.browser is string && request.resource.data.browser.size() <= 12
        && request.resource.data.first is bool
        && request.resource.data.views == 1
        && request.resource.data.at == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views is int
        && request.resource.data.views > resource.data.views
        && request.resource.data.views <= 999;
    }

    // 관리자 목록: 본인이 관리자인지만 확인할 수 있습니다
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // 운영자 지급: 관리자가 만들고, 받는 사람은 '받음'으로 바꾸기만 할 수 있습니다
    match /gifts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'stones', 'crystals', 'note', 'claimed', 'at', 'by'])
        && request.resource.data.uid is string
        && request.resource.data.stones is int && request.resource.data.stones >= -1000000 && request.resource.data.stones <= 1000000
        && request.resource.data.crystals is int && request.resource.data.crystals >= -100000 && request.resource.data.crystals <= 100000
        && request.resource.data.note is string && request.resource.data.note.size() <= 100
        && request.resource.data.claimed == false
        && request.resource.data.at == request.time
        && request.resource.data.by == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && resource.data.claimed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt'])
        && request.resource.data.claimed == true
        && request.resource.data.claimedAt == request.time;
      allow delete: if isAdmin();
    }

    // 쿠폰: 관리자가 만들고, 사용자는 코드마다 한 번만 (사용 수 +1 과 받은 기록을 함께 써야 함)
    match /coupons/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() && validCoupon(request.resource.data) && request.resource.data.uses == 0;
      allow update: if (isAdmin() && validCoupon(request.resource.data))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1
          && resource.data.active == true
          && resource.data.uses < resource.data.maxUses
          && !exists(/databases/$(database)/documents/coupons/$(code)/redeemed/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/coupons/$(code)/redeemed/$(request.auth.uid)));
      allow delete: if isAdmin();

      match /redeemed/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if isAdmin();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/coupons/$(code)).data.uses == get(/databases/$(database)/documents/coupons/$(code)).data.uses + 1;
      }
    }
  }

  function validCoupon(c) {
    return c.keys().hasOnly(['stones', 'crystals', 'maxUses', 'uses', 'active'])
      && c.stones is int && c.stones >= 0 && c.stones <= 1000000
      && c.crystals is int && c.crystals >= 0 && c.crystals <= 100000
      && c.maxUses is int && c.maxUses >= 1 && c.maxUses <= 1000000
      && c.uses is int && c.uses >= 0
      && c.active is bool;
  }

  function validGame(g) {
    return g is map
      && g.keys().hasOnly(['v', 'stones', 'crystals', 'readings', 'colors', 'prayers', 'items', 'love', 'free100Day', 'free10At', 'ex3At'])
      && g.stones is int && g.stones >= 0 && g.stones <= 10000000
      && g.crystals is int && g.crystals >= 0 && g.crystals <= 1000000
      && g.readings is map && g.readings.size() <= 130
      && g.colors is map && g.colors.size() <= 130
      && g.prayers is list && g.prayers.size() <= 200
      && g.items is list && g.items.size() <= 200
      && (!('love' in g) || (g.love is map && g.love.size() <= 130));
  }
}
